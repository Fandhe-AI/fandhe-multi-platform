-            state.lock().unwrap().ime_allowed = allowed;
+            if !allowed {
+                // Finish the old field's composition before the permission is dropped, so
+                // late `WM_IME_*` messages cannot be attributed to the next field.
+                // `ImmNotifyIME` re-enters the window procedure, so no lock may be held.
+                let composing = state.lock().unwrap().ime_state != ImeState::Disabled;
+                if composing {
+                    // SAFETY: `window` is this Window's own HWND and we are on its
+                    // event-loop thread (`execute_in_thread`); no state lock is held.
+                    ImeContext::cancel_composition(window);
