+            {
+                let mut w = state.lock().unwrap();
+                w.ime_allowed = allowed;
+                if !allowed {
+                    w.ime_state = ImeState::Disabled;
+                }
+            }
             ImeContext::set_ime_allowed(window, allowed);
         })
