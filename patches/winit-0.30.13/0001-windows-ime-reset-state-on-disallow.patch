+    /// Cancels any composition in progress on `hwnd`.
+    ///
+    /// The IME reports the cancellation synchronously through `WM_IME_COMPOSITION` /
+    /// `WM_IME_ENDCOMPOSITION`, so callers must not hold the window state lock.
+    ///
+    /// # Safety
+    ///
+    /// `hwnd` must be a valid window handle owned by the calling (window) thread.
+    pub unsafe fn cancel_composition(hwnd: HWND) {
+        // SAFETY: `system_has_ime` only queries `GetSystemMetrics`; no pointer is involved.
+        if !unsafe { ImeContext::system_has_ime() } {
+            return;
+        }
+        // SAFETY: the caller guarantees `hwnd` is valid and on its owning thread, so
+        // `ImmGetContext` returns that window's HIMC (or 0), released when `ImeContext` drops.
+        let ime_context = unsafe { ImeContext::current(hwnd) };
+        if ime_context.himc != 0 {
+            // SAFETY: `himc` is non-zero and alive for the scope of `ime_context`;
+            // CPS_CANCEL takes no buffer, so the null `0` dwValue is valid.
+            unsafe { ImmNotifyIME(ime_context.himc, NI_COMPOSITIONSTR, CPS_CANCEL, 0) };
+        }
+    }
+
