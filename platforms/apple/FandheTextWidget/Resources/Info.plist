<?xml version="1.0" encoding="UTF-8"?>
<!--
  Issue #1065: WidgetKit 拡張の Info.plist。FandheAppGroupIdentifier は Swift 側が
  App Group コンテナを開くための ID で、$(TeamIdentifierPrefix) はビルド時に署名チームの
  接頭辞へ展開される（Team ID をリポジトリに書かない、security.md A05）。
  bundle id はホストアプリ（com.fandhe.widgethost）の接頭辞配下にする。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Fandhe Text Widget</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.fandhe.widgethost.text</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>FandheTextWidget</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>FandheAppGroupIdentifier</key>
    <string>$(TeamIdentifierPrefix)com.fandhe.widget</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.widgetkit-extension</string>
    </dict>
</dict>
</plist>
