<?xml version="1.0" encoding="utf-8"?>
<!--
  codex-review 指摘（PR #931）: `allowBackup="false"` はクラウドバックアップを止めるが、
  Android 12 以降の端末間移行（device-to-device transfer）は一部メーカー端末で
  `allowBackup` の値に関係なく動作する
  （https://developer.android.com/identity/data/autobackup#EnablingAutoBackup）。
  移行先で `fandhe_secure_credential.xml`（EncryptedSharedPreferences の保存ファイル。
  MainActivity.java の SECURE_CREDENTIAL_FILE と対応）だけが復元されると、Keystore の
  鍵が無いため EncryptedSharedPreferences の初期化自体が失敗し、STORE/LOAD/DELETE の
  全操作が失敗し続ける（新しい保存も削除もできない）。cloud-backup・device-transfer の
  両ドメインから当該ファイルを除外し、allowBackup=false と二重に防御する。
  他のデータは対象外のため現状の挙動（allowBackup=false でバックアップ自体が無効）を
  変えない。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fandhe_secure_credential.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fandhe_secure_credential.xml" />
    </device-transfer>
</data-extraction-rules>
