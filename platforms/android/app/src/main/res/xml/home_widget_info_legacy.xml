<?xml version="1.0" encoding="utf-8"?>
<!-- 旧名 receiver（com.fandhe.androidapp.HomeWidgetProvider）用の提供情報。配置済みウィジェットの
     更新を受け続けるためだけに残す。widgetCategory を keyguard にしてホーム画面の選択画面へ
     重複表示させない。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_widget_description"
    android:initialLayout="@layout/home_widget"
    android:minHeight="40dp"
    android:minWidth="110dp"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="keyguard" />
