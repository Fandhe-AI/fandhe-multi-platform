    <restriction
        android:key="fandheSampleInteger"
        android:restrictionType="integer"
        android:title="@string/restriction_sample_integer" />
    <restriction
        android:key="fandheSampleText"
        android:restrictionType="string"
        android:title="@string/restriction_sample_text" />
</restrictions>
