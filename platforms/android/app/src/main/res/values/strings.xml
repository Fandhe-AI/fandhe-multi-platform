<?xml version="1.0" encoding="utf-8"?>
<!-- アプリ表示名のみの最小リソース（TASK-11.2-S2 / REQ-11、Issue #226）。
     AndroidManifest.xml の android:label が参照する。 -->
<resources>
    <string name="app_name">Fandhe</string>
    <!-- 管理アプリ設定（Issue #946）の制限スキーマの表示名。`res/xml/app_restrictions.xml` から参照する。
         キーは `fandhe_cap_managed_app_config` の固定 3 キーと一致させる。切り離し時に削除する。 -->
    <string name="restriction_sample_bool">サンプル（真偽）</string>
    <string name="restriction_sample_integer">サンプル（整数）</string>
    <string name="restriction_sample_text">サンプル（文字列）</string>
    <!-- ファイル画面に出る保存先の表示名（Issue #1020）。`fandhe_core::screens::file_provider_show::ROOT_TITLE`
         と一致させる。切り離し時に削除する。 -->
    <string name="file_provider_root_title">Fandhe（この端末内のみ）</string>
    <!-- 車載ディスプレイ（Issue #1117）の固定文言。見出し・行の title・未設定時の表示。切り離し時に削除する。 -->
    <string name="car_display_title">Fandhe</string>
    <string name="car_display_row_title">メッセージ</string>
    <string name="car_display_unset">未設定</string>
</resources>
