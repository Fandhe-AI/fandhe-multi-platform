<?xml version="1.0" encoding="utf-8"?>
<!-- アプリ表示名のみの最小リソース（TASK-11.2-S2 / REQ-11、Issue #226）。
     AndroidManifest.xml の android:label が参照する。 -->
<resources>
    <string name="app_name">Fandhe</string>
    <!-- ローカル通知（Issue #1006）の通知チャンネル表示名（システム設定 > アプリ >
         通知 に出る名前）。切り離し時に削除する。 -->
    <string name="notification_channel_name">通知</string>
    <!-- ホーム画面ウィジェット（Issue #1067）の一覧表示名・説明。切り離し時に削除する。 -->
    <string name="home_widget_label">Fandhe テキスト</string>
    <string name="home_widget_description">アプリで保存した 1 行の文字を表示します。</string>
    <!-- アプリアイコンのバッジ（Issue #1362）用チャンネル名と通知本文。切り離し時に削除する。 -->
    <string name="app_badge_channel_name">アイコンのバッジ</string>
    <string name="app_badge_notification_text">アイコンのバッジ用の通知です。</string>
    <string name="live_activity_channel_name">ライブアクティビティ</string>
    <string name="live_activity_notification_title">ライブアクティビティ</string>
    <string name="live_activity_notification_prefix">現在の値: </string>
    <string name="now_playing_channel_name">再生中</string>
    <!-- 通話 UI 統合（Issue #278）の着信チャンネル名・PhoneAccount ラベル・固定の発信者名。切り離し時に削除する。 -->
    <string name="call_ui_channel_name">着信</string>
    <string name="call_ui_account_label">Fandhe 通話</string>
    <string name="call_ui_caller_name">Fandhe テスト着信</string>
    <!-- クイック設定タイル（Issue #720）の表示名。fandhe_core の
         `screens::quick_settings_tile_show::TILE_LABEL` と一致させる。切り離し時に削除する。 -->
    <string name="quick_settings_tile_label">Fandhe カウント</string>
    <!-- 管理アプリ設定（Issue #946）の制限スキーマの表示名。`res/xml/app_restrictions.xml` から参照する。
         キーは `fandhe_device::managed_app_config` の固定 3 キーと一致させる。切り離し時に削除する。 -->
    <string name="restriction_sample_bool">サンプル（真偽）</string>
    <string name="restriction_sample_integer">サンプル（整数）</string>
    <string name="restriction_sample_text">サンプル（文字列）</string>
</resources>
