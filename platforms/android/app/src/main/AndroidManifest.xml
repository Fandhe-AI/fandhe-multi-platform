<?xml version="1.0" encoding="utf-8"?>
<!--
  カタログアプリ（fandhe-gallery）の殻の Manifest（Issue #1194）。

  MainActivity の宣言（lib_name・intent-filter・configChanges）・権限・uses-feature・queries・
  機能 crate のコンポーネント・application 直下の meta-data・バックアップ規則は、
  `cargo fandhe gen` が機能 crate の宣言から作る `crates/fandhe-gallery/gen/android/AndroidManifest.xml`
  を manifest merger で重ねて入れる（build.gradle.kts の `apply(from = ...fandhe.gradle)`）。
  ここにはアプリ全体の値（application の属性）だけを書く（docs/architecture/capability-declaration.md）。

  - android:theme: GameActivity は AppCompatActivity のサブクラスのため Theme.AppCompat 系
    （res/values/themes.xml の "AppTheme"）が要る（未指定だと起動時に AppCompatDelegate が例外を投げる）
  - android:localeConfig: アプリが対応する言語の一覧（per-app-language、res/xml/locale_config.xml）
  - android:networkSecurityConfig: 通信先の制限はアプリが書く（background-download・background-upload）。
    平文は 127.0.0.1 と localhost だけ（`adb reverse` の確認用サーバー、res/xml/network_security_config.xml）
  - A05（セキュリティ設定ミス）: android:debuggable・usesCleartextTraffic は書かない
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme" />
</manifest>
