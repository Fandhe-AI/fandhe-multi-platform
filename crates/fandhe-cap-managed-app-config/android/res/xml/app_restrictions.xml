<?xml version="1.0" encoding="utf-8"?>
<!-- Issue #946: MDM 管理アプリ設定の制限スキーマ。キーは本 crate の固定 3 キーと完全一致させる。
     defaultValue は書かない（OS が返した値だけを画面に出す方針）。Manifest の参照は宣言の
     `application-meta-data`（android.content.APP_RESTRICTIONS）が出す。 -->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">
    <restriction
        android:key="fandheSampleBool"
        android:restrictionType="bool"
        android:title="@string/restriction_sample_bool" />
    <restriction
        android:key="fandheSampleInteger"
        android:restrictionType="integer"
        android:title="@string/restriction_sample_integer" />
    <restriction
        android:key="fandheSampleText"
        android:restrictionType="string"
        android:title="@string/restriction_sample_text" />
</restrictions>
