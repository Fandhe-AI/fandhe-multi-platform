{
  "name": "fandhe-web-dom サンプル画面",
  "short_name": "fandhe",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./?screen=file_association_show",
      "accept": { "text/plain": [".txt"] }
    }
  ]
}
