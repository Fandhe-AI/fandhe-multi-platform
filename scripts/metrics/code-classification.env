# 共通/プラットフォーム別コードの分類 SSOT（TASK-2.2-S6 / REQ-2 / M3 Conditional Go 条件 2）。
#
# measure-code-ratio.sh から `source` される（versions.env / unsafe-audit.sh と同じ SSOT 流儀。
# 分類基準の変更をこの 1 ファイルの diff で追跡可能にするのが狙い）。
# 値はすべて固定リテラル（コマンド置換・変数展開を含めない。eval しない前提で読み込むため）。
#
# 分類方針の確定版は docs/architecture/code-ratio-classification.md を参照
# （docs/architecture/prototype-app-design.md 6 章の確定版）。

# --- 共通コード（分子・分母） ---
# TASK-2.2-S1（issue #48）で切り出した独立クレート。fandhe-core のみに依存し
# #![forbid(unsafe_code)] を付与済み。配下の *.rs 全体を共通コードとして計上する。
COMMON_SRC_DIRS=(
  "crates/fandhe-prototype/src"
)

# --- プラットフォーム別コード（分母のみ）: ファイル全体が対象 ---
# プロトタイプ描画起動のためにプラットフォーム側へ新設した専用ファイルをここへ追記する。
# S5（issue #52、fandhe-egui-proxy の描画対象切替）はマージ済みだが、既存ファイル
# （app.rs / lib.rs / main.rs）への追記のみでプラットフォーム側専用ファイルは新設して
# いないため、この配列は引き続き空（TASK-2.3 / #54 でマーカー方式を採用。下記
# PLATFORM_MARKER_DIRS 参照）。将来「専用ファイル」として切り出す場合はこの配列へ
# 相対パスを追記する（例: "crates/fandhe-egui-proxy/src/prototype_entry.rs"）。
# パス表記は measure-code-ratio.sh が REPO_ROOT へ cd した上で `find` の出力（REPO_ROOT からの
# 相対パス）と `platform_files_seen` 連想配列のキーで突き合わせるため、必ず REPO_ROOT からの
# 相対パスで書くこと（先頭 "/" を付けた絶対パスは `[ -f ]` は通っても突き合わせが不一致になり、
# ファイル全体とマーカー区間の両方で二重計上されるおそれがある）。
PLATFORM_FILES=()

# --- プラットフォーム別コード（分母のみ）: マーカー区間走査対象ディレクトリ ---
# 既存プラットフォームファイルに直接プロトタイプ向け差分を追記する場合
# （専用ファイル化しない場合）は、当該差分を
#   // fandhe-prototype:begin
#   ...
#   // fandhe-prototype:end
# のコメント対で囲む（区間内をプラットフォーム別コードとして計上、begin/end 不対応は fail-closed）。
# TASK-2.3（#54）で S5（#52）の app.rs / lib.rs / main.rs 差分へマーカーを付与済み。
# 走査対象ディレクトリをここへ列挙する。
PLATFORM_MARKER_DIRS=(
  "crates/fandhe-egui-proxy/src"
)
