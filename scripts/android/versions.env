# Android NDK・Gradle 導入（TASK-18.3 / REQ-18）で固定するバージョンとチェックサムの一元管理ファイル。
#
# setup-android-env.sh から `set -a; . versions.env; set +a` で読み込まれる。
# 陳腐化時の更新箇所をこの 1 ファイルに限定するための唯一の SSOT（Single Source of Truth）。
# 値はすべて固定リテラル（コマンド置換・変数展開を含めない。eval しない前提で読み込むため）。
#
# 各バージョン・チェックサムは以下の一次情報から取得（取得日 2026-07-29。
# macOS arm64 分の JDK_MACOS_* は Issue #541 対応で追記、取得日 2026-08-12）:
#   - JDK: https://github.com/adoptium/temurin21-binaries/releases/tag/jdk-21.0.12%2B8
#          （<asset>.sha256.txt を直接取得し照合。AGP 8.x の JDK 17 以上要件を満たす LTS。
#          Linux x64 に加え、開発機（Apple Silicon Mac）向けに macOS arm64 版も同一
#          バージョンで固定する）
#   - Android commandline-tools: https://dl.google.com/android/repository/repository2-3.xml
#          （cmdline-tools;latest の linux archive、公式 checksum は sha1 で提供されるため
#            アルゴリズムも sha1 で固定）
#   - NDK / platform-tools / platforms / build-tools: 同 repository2-3.xml。
#          sdkmanager 経由の取得となり、ダウンロード実体の検証は sdkmanager 自身が
#          repository2-3.xml のチェックサムと照合する（sdkmanager の実装に検証を委譲）。
#   - Gradle: https://services.gradle.org/versions/current
#          （bin.zip.sha256 を直接取得し照合）

# --- JDK (Eclipse Temurin, LTS) ---
JDK_VERSION="21.0.12+8"
JDK_ARCHIVE_NAME="OpenJDK21U-jdk_x64_linux_hotspot_21.0.12_8.tar.gz"
JDK_URL="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12_8.tar.gz"
JDK_SHA256="e4446ff06a276155697597cc0f1b15da004ff083f4964a35271ecee567177370"
# tar.gz 展開後のトップレベルディレクトリ名（JAVA_HOME の実体。Linux/macOS 共通）
JDK_EXTRACTED_DIR="jdk-21.0.12+8"

# macOS arm64（Apple Silicon）版。setup-android-env.sh が uname -s = Darwin のときのみ
# 参照する（#541）。Temurin macOS 配布物は展開すると
# <top>/Contents/Home 配下に本体一式が入るバンドル構造のため、install_jdk 側で
# Contents/Home を JDK_EXTRACTED_DIR の実体としてフラット化する。
JDK_MACOS_ARCHIVE_NAME="OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.12_8.tar.gz"
JDK_MACOS_URL="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12%2B8/OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.12_8.tar.gz"
JDK_MACOS_SHA256="021d629349ebc12a409faa517b837ec80ceee8f58a5ac85c788ecad07ca6881c"

# --- Android SDK commandline-tools ---
CMDLINE_TOOLS_VERSION="22.0"
CMDLINE_TOOLS_ARCHIVE_NAME="commandlinetools-linux-15859902_latest.zip"
CMDLINE_TOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip"
# 公式配布（repository2-3.xml）が sha256 ではなく sha1 のみを提供するため、
# このアーティファクトに限りアルゴリズムを sha1 に固定する（setup-android-env.sh 側で分岐）。
CMDLINE_TOOLS_SHA1="040d3996a65543d22ec4bf73e4c37aa37a8d4af4"

# --- Android SDK パッケージ（sdkmanager 経由。検証は sdkmanager 自身に委譲） ---
NDK_PACKAGE="ndk;27.3.13750724"
NDK_REVISION="27.3.13750724"
PLATFORM_PACKAGE="platforms;android-35"
# TASK-11.2-S2（REQ-11、Issue #226）で 35.0.1 から 36.0.0 へ更新（取得日 2026-07-31）。
# AGP 9.3.1（下記 AGP_VERSION）が要求する最小 build-tools バージョンが 36.0.0 であり
# （`gradle :app:bundleRelease` 実行時の AGP 側 WARNING で確認）、35.0.1 のままだと
# Gradle が sdkmanager ライセンス同意済みの前提でビルド時に build-tools 36.0.0 を
# 本スクリプトの管理外で自動導入してしまう（チェックサム検証済みの導入経路から外れる、
# security.md A05/A06 対策上望ましくない）。ここを SSOT として更新し、
# setup-android-env.sh 経由の導入対象に含める。
BUILD_TOOLS_PACKAGE="build-tools;36.0.0"
PLATFORM_TOOLS_PACKAGE="platform-tools"

# --- Gradle ---
GRADLE_VERSION="9.6.1"
GRADLE_ARCHIVE_NAME="gradle-9.6.1-bin.zip"
GRADLE_URL="https://services.gradle.org/distributions/gradle-9.6.1-bin.zip"
GRADLE_SHA256="9c0f7faeeb306cb14e4279a3e084ca6b596894089a0638e68a07c945a32c9e14"

# --- rustup 側で追加する Android クロスコンパイルターゲット ---
# TASK-1.5-S1 / TASK-1.6 / TASK-11.2（cargo-ndk 経由の Android ビルド）の前提として
# 最小限のみ同梱。
RUST_ANDROID_TARGETS="aarch64-linux-android armv7-linux-androideabi x86_64-linux-android"

# --- cargo-ndk（TASK-1.5-S1 / REQ-1）---
# 選定根拠（取得日 2026-07-30）:
#   - crates.io: https://crates.io/crates/cargo-ndk/4.1.2（`cargo info cargo-ndk` で確認。
#     crates.io API への直接アクセスはレート制限で拒否されたため cargo 経由で取得）
#   - rust-version（MSRV）= 1.86 であり、rust-toolchain.toml 固定の 1.88.0 を満たす
#     （egui 0.34 系回避（TASK-1.2）と同じ MSRV 判断基準）
#   - CHANGELOG: https://github.com/bbqsrc/cargo-ndk/blob/main/CHANGELOG.md
#     v4.0.0 で「Add relevant linker flags for NDKs older than 27 to support 16kb
#     page sizes」に対応済みで、versions.env 固定の NDK 27.3.13750724（NDK r27）と
#     組み合わせて利用できることを確認
#   - RUSTSEC 勧告: 本バージョン時点で cargo-ndk 自体への勧告は確認されず
CARGO_NDK_VERSION="4.1.2"

# --- Android 最小 API レベル（TASK-1.5-S1 / REQ-1）---
# Vulkan バックエンド（TASK-1.5-S2 以降）が前提とする API レベル。
# cargo-ndk の --platform フラグにそのまま渡す。
ANDROID_MIN_API="24"

# --- GameActivity（TASK-9.3-S1 / REQ-9 / M4、Issue #242）---
# platforms/android/ の Gradle プロジェクトが依存する Jetpack ライブラリ。
# android-activity 0.6.1（crates/fandhe-egui-proxy・fandhe-winit-ime が選択する
# "android-game-activity" feature）が対応する GameActivity バージョンと一致させる
# 必要がある（android-activity の README で "currently supports the GameActivity 4.4.0
# Jetpack library" と明記。~/.cargo/registry/.../android-activity-0.6.1/README.md
# の "Game Activity Library Version" 節、取得済み一次情報）。
# 決定記録: docs/architecture/android-activity-method.md
GAMES_ACTIVITY_VERSION="4.4.0"

# --- AndroidX AppCompat（TASK-9.3-S1 / REQ-9 / M4、Issue #242）---
# GameActivity は AppCompatActivity のサブクラスとして実装する必要があり
# （android-activity README「GameActivity is based on the AppCompatActivity class」・
# developer.android.com/games/agdk/game-activity/get-started の
# "extend GameActivity from the com.google.androidgamesdk package" 記述、
# 取得日 2026-08-01）、androidx.games:games-activity の AAR 自体は appcompat への
# 依存を POM に含めない（dl.google.com の games-activity-4.4.0.pom を直接確認、
# dependencies セクションなし）ため本プロジェクト側で明示的に追加する。
# 選定根拠（取得日 2026-08-01）: dl.google.com/android/maven2/androidx/appcompat/
# appcompat/maven-metadata.xml の <versions> 一覧末尾から、プレリリース
# （1.8.0-alpha01 / 1.8.0-rc01）を除いた最新安定版 1.7.1 を採用。
APPCOMPAT_VERSION="1.7.1"

# MainActivity の WindowInsets リスナー（ViewCompat / WindowInsetsCompat / Insets、
# Issue #579）が androidx.core を直接 import するため、appcompat の推移依存に
# 頼らず明示的に追加する。選定根拠: appcompat 1.7.1 が要求する androidx.core:core
# のバージョン（1.13.0）に一致させる（推移依存との二重解決を避ける）。
ANDROIDX_CORE_VERSION="1.13.0"

# MainActivity のカメラ Intent 中継（`ActivityResultContracts.RequestPermission` /
# `TakePicturePreview`、Phase 8 の端末機能、Issue #750）が androidx.activity.result を
# 直接 import するため明示依存にする。appcompat 1.7.1 の POM が compile scope で要求する
# androidx.activity:activity のバージョン（1.8.0、ローカル Gradle キャッシュの POM で
# 確認済み）に一致させ、推移依存との二重解決を避ける。
ANDROIDX_ACTIVITY_VERSION="1.8.0"

# --- Android Gradle Plugin（TASK-11.2-S2 / REQ-11）---
# platforms/android/ の Gradle プロジェクト（cargo-ndk 成果物の .aab 統合）が使う AGP。
# 選定根拠（取得日 2026-07-31）:
#   - 互換表: https://developer.android.com/build/releases/gradle-plugin
#     AGP 9.3.0 系の最小要件は Gradle 9.5.0 以上・JDK 17 以上。上記固定の
#     Gradle 9.6.1（>= 9.5.0）・JDK 21.0.12+8（>= 17）のいずれも満たす。
#     対応最大 API レベルは 37 であり、上記固定の compileSdk 35（platforms;android-35）を
#     問題なく扱える。
#   - 配布実体: https://dl.google.com/dl/android/maven2/com/android/tools/build/gradle/maven-metadata.xml
#     （google() Maven リポジトリの一次情報）で 9.3.x 系の安定版として 9.3.1 が
#     9.3.0 の後継として存在することを確認し、より新しい安定版である 9.3.1 を採用した
#     （9.4.0 系は本取得日時点で alpha のため見送り）。
# compileSdk（35）・buildToolsVersion（36.0.0）は PLATFORM_PACKAGE / BUILD_TOOLS_PACKAGE と
# 相互参照させる（platforms/android/app/build.gradle.kts 側のコメント参照）。
AGP_VERSION="9.3.1"

# --- Kotlin / Jetpack Compose（TASK-5.2 / REQ-5、Issue #237） ---
# scripts/metrics/android-memory/（配布用 platforms/android とは分離した検証専用
# Gradle プロジェクト）が使う Kotlin バージョン・Compose バージョン。
# 配布用 platforms/android/app には Java/Kotlin ソースがなく本バージョンの影響を受けない
# （二重管理を避けるため同一 SSOT ファイルへ追記する）。
# 選定根拠（取得日 2026-08-01）:
#   - Kotlin: https://repo1.maven.org/maven2/org/jetbrains/kotlin/kotlin-gradle-plugin/maven-metadata.xml
#     の <versions> 一覧から、ベータ版（2.4.20-Beta2 等）を除いた最新安定版 2.4.10 を採用。
#     AGP 9.0 以降は Kotlin サポートが組み込み（built-in Kotlin support）のため
#     `org.jetbrains.kotlin.android` プラグイン自体は適用しないが、Compose コンパイラ
#     プラグイン（`org.jetbrains.kotlin.plugin.compose`）は本バージョンで明示的に適用する
#     （https://kotl.in/gradle/agp-built-in-kotlin）。
#   - Compose BOM: https://dl.google.com/android/maven2/androidx/compose/compose-bom/maven-metadata.xml
#     の <latest> から 2026.06.01 を採用（compileSdk 35 / AGP 9.3.1 と組み合わせて使用）。
KOTLIN_VERSION="2.4.10"
COMPOSE_BOM_VERSION="2026.06.01"
# activity-compose は Compose BOM 管理外（BOM は androidx.compose グループのみを揃える）
# のため個別に固定する。取得日 2026-08-01。最新版（1.13.0、
# https://dl.google.com/android/maven2/androidx/activity/activity-compose/maven-metadata.xml
# の <latest>）は androidx.navigationevent へ推移的に依存し compileSdk 36 以上を要求するが、
# 本プロジェクトの compileSdk は distribution 側（platforms/android、PLATFORM_PACKAGE=
# platforms;android-35）と同じ 35 に揃える方針のため採用しない。compileSdk 35 と両立する
# 最終バージョン 1.9.3 を採用する（`gradle :native-sample:assembleDebug` の
# checkDebugAarMetadata で compileSdk 要求を確認済み）。
ACTIVITY_COMPOSE_VERSION="1.9.3"

# --- bundletool（TASK-11.3 / REQ-11、Issue #246） ---
# `.aab` を実機/エミュレータへインストールするための公式ツール（adb は `.aab` を
# 直接インストールできないため必須。`docs/architecture/android-aab-pipeline.md` §6・§8）。
# 選定根拠（取得日 2026-08-01）:
#   - 一次情報: https://github.com/google/bundletool/releases（GitHub Releases API
#     `repos/google/bundletool/releases/latest` で確認。公式配布元の最新安定版を採用。
#     個別の脆弱性データベース照会は実施していない）
#   - 採用バージョン: 1.18.3（本取得日時点の latest）
#   - アセット名: bundletool-all-1.18.3.jar（バージョン番号をファイル名に含めることで、
#     setup-android-env.sh 側の完了マーカー（ファイル存在）がバージョン更新に追従する。
#     cmdline-tools/latest のバージョン非依存シンボリックリンクと同じ落とし穴を避けるため）
# チェックサム: bundletool は sha256/sha1 のテキストファイルを配布せず、GitHub Releases API
# の各アセットが持つ `digest` フィールド（sha256、GitHub 自身が算出する一次情報）を
# 採用する。`gh api repos/google/bundletool/releases/latest --jq
# '.assets[] | select(.name=="bundletool-all-1.18.3.jar") | .digest'` で取得し、
# 実ダウンロードした jar の sha256sum と一致することを確認済み。
BUNDLETOOL_VERSION="1.18.3"
BUNDLETOOL_JAR_NAME="bundletool-all-1.18.3.jar"
BUNDLETOOL_URL="https://github.com/google/bundletool/releases/download/1.18.3/bundletool-all-1.18.3.jar"
BUNDLETOOL_SHA256="a099cfa1543f55593bc2ed16a70a7c67fe54b1747bb7301f37fdfd6d91028e29"

# --- AndroidX Biometric（Phase 11 端末機能の拡充ループ、Issue #908） ---
# MainActivity の生体認証中継（`BiometricPrompt`/`BiometricManager`）が
# androidx.biometric を直接 import するため明示依存にする。
# 選定根拠（取得日 2026-09-16）:
#   - 一次情報: https://dl.google.com/android/maven2/androidx/biometric/biometric/maven-metadata.xml
#     の <versions> 一覧から、プレリリース（1.2.0-alpha 系）を除いた最新安定版 1.1.0 を採用。
#   - `BiometricPrompt(FragmentActivity, Executor, AuthenticationCallback)` は
#     `FragmentActivity` を要求するが、`MainActivity`（`GameActivity` →
#     `AppCompatActivity` → `FragmentActivity`）は既にこの要件を満たしており
#     追加の橋渡しは不要（biometric-auth.json android.note の既存判断を踏襲）。
BIOMETRIC_VERSION="1.1.0"

# --- AndroidX Security Crypto（Phase 11 端末機能の拡充ループ、Issue #924） ---
# MainActivity の資格情報中継（`EncryptedSharedPreferences`/`MasterKey`）が
# androidx.security.crypto を直接 import するため明示依存にする。
# 選定根拠（取得日 2026-09-17）:
#   - 一次情報: https://dl.google.com/android/maven2/androidx/security/security-crypto/
#     maven-metadata.xml の <versions> 一覧から、プレリリース（1.1.0-alpha/beta 系）を
#     除いた最新安定版 1.1.0 を採用（`<latest>`/`<release>` も 1.1.0 で一致）。
#   - リリースノート https://developer.android.com/jetpack/androidx/releases/security
#     によると 1.1.0-alpha07（2025-04-09）で `EncryptedSharedPreferences`/`MasterKey`
#     を含む全 API が deprecated（「Android Keystore の直接利用を推奨」）になっている。
#     1.1.0（2025-07-30 リリース）時点でも API 自体は動作するため、Issue #924 の
#     明示要件どおり本バージョンを採用する。Keystore 直接実装への置き換えは
#     スコープ外（PR 本文に記載、承認後に別 Issue）。
#   - 推移依存（`security-crypto-1.1.0.pom`）: com.google.crypto.tink:tink-android:1.8.0、
#     androidx.collection:1.4.2、androidx.annotation:1.8.1、org.jspecify:1.0.0。
#   - 供給網確認（OSV、取得日 2026-09-17）: `androidx.security:security-crypto@1.1.0`・
#     `com.google.crypto.tink:tink-android@1.8.0` とも既知の勧告なし
#     （`curl https://api.osv.dev/v1/query -d '{"package":{...},"version":"..."}'` が
#     両方とも `{}` を返す）。
SECURITY_CRYPTO_VERSION="1.1.0"

# --- AndroidX Work（Phase 11 端末機能の拡充ループ、Issue #1046） ---
# MainActivity のバックグラウンド処理中継（`WorkManager`/`OneTimeWorkRequest`）が
# androidx.work.work-runtime を直接 import するため明示依存にする。
# 選定根拠（取得日 2026-10-02）:
#   - 一次情報: https://dl.google.com/dl/android/maven2/androidx/work/work-runtime/
#     maven-metadata.xml の <latest>/<release> が揃って示す最新安定版 2.12.0 を採用
#     （プレリリース 2.12.0-alpha/beta/rc は除外）。
#   - AAR metadata（work-runtime-2.12.0.aar 内 aar-metadata.properties）:
#     minCompileSdk=35（本リポジトリの compileSdk 35 と一致）。
#   - リリースノート https://developer.android.com/jetpack/androidx/releases/work
#     によると 2.11.0-alpha01 で minSdk が API 21 から 23 へ上がっている。本リポジトリの
#     ANDROID_MIN_API（24）は 23 以上のため 2.12.0 でも問題なく使える。
#   - 推移依存（work-runtime-2.12.0.pom）: androidx.room:room-runtime:2.7.0、
#     androidx.tracing:tracing-ktx:1.2.0、androidx.annotation:annotation-experimental:1.4.1、
#     org.jspecify:jspecify:1.0.0、com.google.guava:listenablefuture:1.0、
#     org.jetbrains.kotlinx:kotlinx-coroutines-android:1.9.0、
#     androidx.lifecycle:lifecycle-service:2.6.2 等。
#   - 供給網確認（OSV、取得日 2026-10-02）: `androidx.work:work-runtime@2.12.0`・
#     `androidx.room:room-runtime@2.7.0` とも既知の勧告なし（`curl
#     https://api.osv.dev/v1/query -d '{"package":{...},"version":"..."}'` が
#     両方とも `{}` を返す）。
WORK_RUNTIME_VERSION="2.12.0"

# --- AndroidX Browser（Custom Tabs、Phase 11 端末機能の拡充ループ、Issue #534） ---
# WebAuthSessionHelper が androidx.browser.customtabs.CustomTabsIntent を直接 import するため
# 明示依存にする。
# 選定根拠（取得日 2026-10-21）:
#   - 一次情報: https://dl.google.com/android/maven2/androidx/browser/browser/maven-metadata.xml
#     の <versions> 一覧。1.9.0 / 1.10.0 は aar-metadata.properties の minCompileSdk=36 で、
#     本リポジトリの compileSdk 35 では使えないため、minCompileSdk=34 の 1.8.0 を採用。
#   - AAR metadata（browser-1.8.0.aar 内 aar-metadata.properties）: minCompileSdk=34・
#     minSdkVersion=19。ANDROID_MIN_API（24）は 19 以上のため minSdk 全域で使える。
#   - 推移依存: androidx.core 等（既存の 1.13.0 へ解決される）。
#   - 供給網確認（OSV、取得日 2026-10-21）: `androidx.browser:browser@1.8.0` は既知の勧告なし
#     （`curl https://api.osv.dev/v1/query` が `{}` を返す）。
ANDROIDX_BROWSER_VERSION="1.8.0"

# --- AndroidX Window（Jetpack WindowManager、Phase 11 端末機能の拡充ループ、foldable-posture の Android） ---
# 折りたたみ端末の姿勢・折れ目（`WindowInfoTracker` の `FoldingFeature`）を Java から受けるため、
# `androidx.window:window` と `androidx.window:window-java`（`WindowInfoTrackerCallbackAdapter`）を
# 明示依存にする。同じ版で揃える。
# 選定根拠（取得日 2026-10-30）:
#   - 一次情報: https://dl.google.com/android/maven2/androidx/window/window/maven-metadata.xml
#     の <versions> 一覧から、プレリリース（alpha/beta/rc）を除いた最新安定版 1.5.1
#     （2025-11-19）を採用。`window-java` も同じ 1.5.1 が存在する。
#   - AAR metadata（window-1.5.1.aar 内 aar-metadata.properties）: minCompileSdk=34。
#     本リポジトリの compileSdk 35 以下のため引き上げは不要。
#   - 推移依存（pom）: org.jetbrains.kotlin:kotlin-stdlib:2.0.21、
#     org.jetbrains.kotlinx:kotlinx-coroutines-android:1.8.1、androidx.core:core:1.8.0、
#     androidx.collection:collection:1.4.2。いずれも既存の依存（work-runtime 経由の
#     kotlinx-coroutines-android・kotlin-stdlib、core、collection）で解決済みで、
#     新しいパッケージ系統は増えない。
#   - 供給網確認（OSV、取得日 2026-10-30）: `androidx.window:window@1.5.1`・
#     `androidx.window:window-java@1.5.1` とも既知の勧告なし
#     （`curl https://api.osv.dev/v1/query -d '{"package":{"name":"...","ecosystem":"Maven"},
#     "version":"1.5.1"}'` が両方とも `{}` を返す）。
WINDOW_VERSION="1.5.1"

# --- Android for Cars App Library（Phase 11 端末機能の拡充ループ、car-display の Android） ---
# 車載画面（DHU / Android Auto）へ `PaneTemplate` を出すため、`androidx.car.app:app` を明示依存にする。
# 推移依存の guava が古く勧告があるため、`GUAVA_VERSION` へ constraints で引き上げる。
# 選定根拠（取得日 2026-10-31）:
#   - 一次情報: https://dl.google.com/android/maven2/androidx/car/app/app/1.7.0/app-1.7.0.module
#     と app-1.7.0.aar。1.7.0 は公式の最新安定版で、CVE-2024-10382 の修正を含む。
#   - AAR metadata（app-1.7.0.aar 内 aar-metadata.properties）: minCompileSdk=34。
#     manifest の minSdkVersion は 21。compileSdk 35・ANDROID_MIN_API（24）のまま使える。
#   - 推移依存（.module の releaseVariantReleaseRuntimePublication）: activity 1.2.0、
#     annotation 1.8.1、annotation-experimental 1.4.1、core 1.7.0、lifecycle-common-java8 2.2.0、
#     lifecycle-viewmodel 2.2.0、media 1.6.0、guava 31.1-android、kotlin-stdlib、
#     kotlin-stdlib-common、jspecify 1.0.0。app-automotive・app-projected・app-testing は
#     dependencyConstraints だけで、取り込まれない。
#   - guava: 31.1-android には OSV の勧告が 3 件ある（GHSA-5mg8-w23w-74h3 LOW、
#     GHSA-7g45-4rm6-3mm3 MODERATE、GHSA-xxph-c9ww-hj94 HIGH）。33.7.2-android は勧告なし。
#     33.7.2-android の .module（repo1.maven.org）の推移依存は failureaccess 1.0.3、
#     listenablefuture 9999.0-empty-to-avoid-conflict-with-guava、jspecify 1.0.1、
#     error_prone_annotations 2.50.0、j2objc-annotations 3.1。
#   - 供給網確認（OSV、取得日 2026-10-31）: 次はすべて既知の勧告なし
#     （`curl https://api.osv.dev/v1/query` が `{}` を返す）。
#     `androidx.car.app:app@1.7.0`、`androidx.media:media@1.6.0`、
#     `androidx.lifecycle:lifecycle-common-java8@2.2.0`、`lifecycle-viewmodel@2.2.0`、
#     `androidx.activity:activity@1.2.0`、`com.google.guava:guava@33.7.2-android`、
#     guava の推移依存 5 件（上記の版）。
CAR_APP_VERSION="1.7.0"
GUAVA_VERSION="33.7.2-android"
